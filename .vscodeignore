# Source and build tooling (not needed at runtime)
src/**
node_modules/**
.vscode/**
.vscode-test/**
.codex/**
.agents/**
.claude/**
.git/**
.github/**
.githooks/**
scripts/**
mcp/**
# The c4x-lint CLI bundle (#216) is for hooks and CI, not the extension host.
cli/**
# The c4x agent skill (#355) is distributed through the plugin packages (#358, #359), not the extension.
skills/**
# The plugin packages (#358, #359, #377) ship through the public repository, not the extension.
plugins/**
# The npm package sources (#356) publish to npm, not into the extension.
npm/**
# Its staging directory (scripts/npm-package.js, default dist/npm/c4x) is left behind by `make verify-npm`.
dist/npm/**
.claude-plugin/**
gemini-extension.json
.pre-commit-hooks.yaml
test/**
coverage/**
.coverage/**
.test-report/**
test-results/**

# Docs (keep README, CHANGELOG, LICENSE, NOTICE.md and THIRD_PARTY_NOTICES.txt at root —
# NOTICE.md covers the icon artwork, THIRD_PARTY_NOTICES.txt the npm packages inlined into dist/extension.js)
docs/**
examples/**
samples/**
wiki/**

# Non-runtime assets (the cloud icon artwork; the AWS and Azure sprites ship once as data/cloud-icons.json, which the extension
# and the MCP server bundle read at first use, #534)
assets/cloud/**

# Marketplace listing imagery. vsce rewrites every relative link in README.md
# to https://github.com/<repo>/raw/HEAD/<path>, so the Marketplace and Open VSX
# render these straight from GitHub and never read them out of the VSIX. Only
# the icon declared in package.json ("icon") has to ship. Verified by
# unpacking the VSIX: zero relative image links survive in the packaged README.
assets/marketplace/**
!assets/marketplace/icon.png

# Source maps never ship. The extension bundle is deliberately unminified
# (see esbuild.config.js), so a shipped .map buys nothing and cost 741 KB.
**/*.map

# Build config files
tsconfig.json
tsconfig.unit.json
.mocharc.unit.yml
esbuild.config.js
eslint.config.mjs
.eslintrc.json
.gitignore
.gitattributes
.mailmap
.nvmrc
.markdownlint.json
.mcp.json
Makefile
.env.example
pnpm-lock.yaml
*.code-workspace

# Non-shipping markdown
CONTRIBUTING.md
DEVELOPER.md
run_instruction.md
PRODUCT.md

# Test and temp files
.tmp/**
*.test.ts
*.test.js
out/test/**
out/**
test_output*.log
*.vsix
.env

# Private development harness and planning files
.cursor/**
.windsurf/**
CLAUDE.md
claude.md
GEMINI.md
AGENTS.md
STATUS.md
IMPROVEMENT-PLAN.md
OPERATOR.md
playwright.config.ts
audit/**
audit_prompt_v1_6.md

# Local build archive. Gitignored, and must never ship: it holds old VSIX
# builds and superseded marketplace imagery, which added 0.7 MB to a package
# whose whole point is to stay small.
.archive/**

# Licence notices for the npm packages inlined into dist/extension.js (OP-13).
# Generated by every build; it must ship, so re-include it after every exclusion above.
!THIRD_PARTY_NOTICES.txt

# Repository policy; the README link is rewritten to GitHub by vsce.
SECURITY.md
.markdownlintignore

# The extension-host test workspace is the checkout, so this file can appear at its root.
# vsce does not honour a leading slash here, so the name matches at any depth; the
# tracked copies under samples/ and test/ are excluded by their directories already.
.c4x-layout.json

# The C4X MCP server bundle (#357): VS Code starts it from the installed extension
# (contributes.mcpServerDefinitionProviders). Only the bundle and its licence
# notices ship; the TypeScript source in mcp/ stays out. Re-included last so the
# mcp/** exclusion above does not win.
!mcp/c4x-mcp-server.bundle.cjs
!mcp/THIRD_PARTY_NOTICES.txt

# The shared AWS and Azure icon data (#534) is the one file the extension and the MCP server read; it must ship.
!data/cloud-icons.json

# Repository front-matter documents; not part of the package.
OVERVIEW.md
DEPENDENCIES.md
