# Source and build tooling (not needed at runtime)
src/**
node_modules/**
.vscode/**
.vscode-test/**
.codex/**
.agents/**
.claude/**
.git/**
.github/**
.githooks/**
scripts/**
mcp/**
# The c4x-lint CLI bundle (#216) is for hooks and CI, not the extension host.
cli/**
.pre-commit-hooks.yaml
test/**
coverage/**
.coverage/**
.test-report/**
test-results/**

# Docs (keep README, CHANGELOG, LICENSE, NOTICE.md and THIRD_PARTY_NOTICES.txt at root —
# NOTICE.md covers the icon artwork, THIRD_PARTY_NOTICES.txt the npm packages inlined into dist/extension.js)
docs/**
examples/**
samples/**
wiki/**

# Non-runtime assets (cloud icons are compiled inline into src/assets/*.ts)
assets/cloud/**

# Marketplace listing imagery. vsce rewrites every relative link in README.md
# to https://github.com/<repo>/raw/HEAD/<path>, so the Marketplace and Open VSX
# render these straight from GitHub and never read them out of the VSIX. Only
# the icon declared in package.json ("icon") has to ship. Verified by
# unpacking the VSIX: zero relative image links survive in the packaged README.
assets/marketplace/**
!assets/marketplace/icon.png

# Source maps never ship. The extension bundle is deliberately unminified
# (see esbuild.config.js), so a shipped .map buys nothing and cost 741 KB.
**/*.map

# Build config files
tsconfig.json
tsconfig.unit.json
.mocharc.unit.yml
esbuild.config.js
eslint.config.mjs
.eslintrc.json
.gitignore
.gitattributes
.mailmap
.nvmrc
.markdownlint.json
.mcp.json
Makefile
pnpm-lock.yaml
*.code-workspace

# Non-shipping markdown
CONTRIBUTING.md
DEVELOPER.md
run_instruction.md
PRODUCT.md

# Test and temp files
.tmp/**
*.test.ts
*.test.js
out/test/**
out/**
test_output*.log
*.vsix
.env

# Private development harness and planning files
.cursor/**
.windsurf/**
CLAUDE.md
claude.md
GEMINI.md
AGENTS.md
STATUS.md
IMPROVEMENT-PLAN.md
OPERATOR.md
playwright.config.ts
audit/**
audit_prompt_v1_6.md

# Local build archive. Gitignored, and must never ship: it holds old VSIX
# builds and superseded marketplace imagery, which added 0.7 MB to a package
# whose whole point is to stay small.
.archive/**

# Licence notices for the npm packages inlined into dist/extension.js (OP-13).
# Generated by every build; it must ship, so re-include it after every exclusion above.
!THIRD_PARTY_NOTICES.txt
