%%{ c4: container }%%
graph TB
    Person(user, "User", "Platform User", $x="200.0", $y="50.0")

    subgraph BankingSystem {
        Container(spa, "Single Page App", "React", $x="200.0", $y="310.0")
        Container(api, "API Application", "Node.js", $x="200.0", $y="570.0", $locked="true")
        ContainerDb(db, "Database", "PostgreSQL", $x="580.0", $y="570.0")
    }

    user -->|Uses| spa
    spa -->|JSON/HTTPS| api
    api -->|Reads/Writes| db
