{
  "mcpServers": {
    "c4x-validator": {
      "command": "node",
      "cwd": ".",
      "args": [
        "mcp/c4x-mcp-server.bundle.cjs"
      ]
    },
    "google-developer-knowledge": {
      "type": "http",
      "url": "https://developerknowledge.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${GOOGLE_DEVELOPER_KNOWLEDGE_API_KEY}"
      }
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.0.5"
      ]
    }
  }
}
