{
  "name": "c4x",
  "displayName": "C4X - C4 Model Diagrams",
  "description": "Visual C4 Model diagrams with instant preview. Support for C4X DSL.",
  "galleryBanner": {
    "color": "#08427B",
    "theme": "dark"
  },
  "icon": "assets/marketplace/icon.png",
  "version": "1.6.2",
  "packageManager": "pnpm@10.18.3",
  "c4xToolchain": {
    "node": [
      "20.20.2",
      "26.5.0"
    ],
    "pnpm": "10.18.3",
    "vscode": "1.128.0",
    "runners": [
      "ubuntu-24.04",
      "macos-15",
      "windows-2025"
    ],
    "actions": {
      "actions/checkout": "34e114876b0b11c390a56381ad16ebd13914f8d5",
      "actions/setup-node": "49933ea5288caeca8642d1e84afbd3f7d6820020",
      "pnpm/action-setup": "0ebf47130e4866e96fce0953f49152a61190b271",
      "actions/upload-artifact": "ea165f8d65b6e75b540449e92b4886f43607fa02",
      "actions/download-artifact": "d3f86a106a0bac45b974a628896c90dbdf5c8093"
    }
  },
  "publisher": "jpantsjoha",
  "author": {
    "name": "Jaroslav Pantsjoha",
    "email": "jpantsjoha@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jpantsjoha/c4x-vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/jpantsjoha/c4x-vscode-extension/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "c4",
    "c4model",
    "architecture",
    "diagrams",
    "visualization",
    "mermaid",
    "markdown",
    "schematics",
    "system design",
    "modeling",
    "documentation",
    "uml",
    "drawing",
    "diagrams-as-code",
    "architecture-as-code",
    "puml",
    "plantuml",
    "structurizr"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.styles": [
      "./assets/styles/markdown.css"
    ],
    "markdown.previewScripts": [
      "./assets/scripts/preview.js"
    ],
    "markdown.enableCommandUris": true,
    "commands": [
      {
        "command": "c4x.openPreview",
        "title": "C4X: Open Preview",
        "category": "C4X"
      },
      {
        "command": "c4x.refreshPreview",
        "title": "C4X: Refresh Preview",
        "category": "C4X"
      },
      {
        "command": "c4x.exportHtml",
        "title": "C4X: Export Markdown to HTML",
        "category": "C4X"
      },
      {
        "command": "c4x.exportPdf",
        "title": "C4X: Export - Preview",
        "category": "C4X"
      },
      {
        "command": "c4x.exportPng",
        "title": "C4X: Export Diagram as PNG",
        "category": "C4X"
      },
      {
        "command": "c4x.exportSvg",
        "title": "C4X: Export SVG",
        "category": "C4X"
      },
      {
        "command": "c4x.copySvg",
        "title": "C4X: Copy SVG To Clipboard",
        "category": "C4X"
      },
      {
        "command": "c4x.changeTheme",
        "title": "C4X: Change Theme",
        "category": "C4X"
      },
      {
        "command": "c4x.ai.generateFromMarkdown",
        "title": "C4X: Generate Diagram Here (Gemini)",
        "category": "C4X"
      },
      {
        "command": "c4x.ai.generateFromSelection",
        "title": "C4X: Diagram from Selection",
        "category": "C4X"
      },
      {
        "command": "c4x.ai.generateVisualDiagram",
        "title": "C4X: Preview - Visual Diagram (PNG)",
        "category": "C4X"
      },
      {
        "command": "c4x.resetLayout",
        "title": "C4X: Reset Visual Layout",
        "category": "C4X"
      },
      {
        "command": "c4x.editMarkdownBlock",
        "title": "C4X: Edit C4 diagram in visual editor",
        "category": "C4X"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "when": "resourceLangId == markdown",
          "command": "c4x.exportPdf",
          "group": "2_workspace@1"
        }
      ],
      "editor/context": [
        {
          "command": "c4x.openPreview",
          "group": "c4x_preview@1",
          "when": "resourceLangId == c4x || resourceExtname == .dsl || resourceExtname == .puml"
        },
        {
          "command": "c4x.exportPng",
          "group": "c4x_export",
          "when": "resourceLangId == c4x"
        },
        {
          "command": "c4x.exportSvg",
          "group": "c4x_export",
          "when": "resourceLangId == c4x"
        },
        {
          "command": "c4x.copySvg",
          "group": "c4x_export",
          "when": "resourceLangId == c4x"
        },
        {
          "command": "c4x.editMarkdownBlock",
          "group": "c4x_preview@1",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "c4x.ai.generateFromMarkdown",
          "group": "c4x_ai",
          "when": "resourceLangId == markdown"
        },
        {
          "command": "c4x.ai.generateFromSelection",
          "group": "c4x_ai",
          "when": "editorHasSelection"
        },
        {
          "command": "c4x.ai.generateVisualDiagram",
          "group": "c4x_ai",
          "when": "editorHasSelection"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceLangId == c4x || resourceExtname == .dsl || resourceExtname == .puml",
          "command": "c4x.openPreview",
          "group": "1_preview@1"
        },
        {
          "when": "resourceLangId == markdown",
          "command": "c4x.exportPdf",
          "group": "3_export@1"
        },
        {
          "when": "resourceLangId == c4x",
          "command": "c4x.exportPng",
          "group": "3_export@2"
        },
        {
          "when": "resourceLangId == c4x",
          "command": "c4x.exportSvg",
          "group": "3_export@3"
        }
      ]
    },
    "keybindings": [
      {
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "command": "c4x.openPreview",
        "when": "editorLangId == c4x || resourceExtname == .dsl || resourceExtname == .puml"
      }
    ],
    "languages": [
      {
        "id": "c4x",
        "aliases": [
          "C4X",
          "c4x"
        ],
        "extensions": [
          ".c4x"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "c4x",
        "path": "./snippets/c4x.json"
      }
    ],
    "grammars": [
      {
        "language": "c4x",
        "scopeName": "source.c4x",
        "path": "./syntaxes/c4x.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "C4X",
      "properties": {
        "c4x.theme": {
          "type": "string",
          "default": "classic",
          "enum": [
            "classic",
            "modern",
            "muted",
            "high-contrast",
            "auto"
          ],
          "enumDescriptions": [
            "Official C4 Model colors (Simon Brown specification)",
            "Vibrant colors with rounded corners",
            "Grayscale minimalist for professional documentation",
            "WCAG AAA compliant (7:1 contrast ratio)",
            "Adapts to VS Code light/dark theme automatically"
          ],
          "description": "C4 diagram theme"
        },
        "c4x.ai.apiKey": {
          "type": "string",
          "default": "",
          "markdownDeprecationMessage": "**Deprecated**: API keys are now stored in VS Code's encrypted SecretStorage. Any key found here will be auto-migrated and this setting cleared.",
          "deprecationMessage": "Deprecated: API keys are now stored securely. This setting will be auto-migrated and cleared.",
          "description": "DEPRECATED: API keys are now stored in VS Code's encrypted SecretStorage. Any value here will be automatically migrated to secure storage and this setting cleared on next activation.\n\nTo enter a new key, use the 'Enter Key' prompt when running any C4X AI command."
        },
        "c4x.ai.model": {
          "type": "string",
          "default": "gemini-3.5-flash",
          "description": "Gemini model ID for AI diagram generation. Enter any model ID your API key supports.\n\nRecommended models (May 2026):\n- gemini-3.5-flash — Fast, frontier performance (default)\n- gemini-3.1-pro-preview — Best reasoning, 1M context (failover)\n- gemini-3.1-flash-lite-preview — Budget option, frontier performance\n- gemini-2.5-pro — Stable (sunset June 2026)\n\nSee https://ai.google.dev/gemini-api/docs/models for all available models."
        },
        "c4x.ai.imageModel": {
          "type": "string",
          "default": "gemini-3.1-flash-image-preview",
          "description": "Gemini model ID for visual PNG diagram generation. Enter any image-capable model ID your API key supports.\n\nRecommended image models (March 2026):\n- gemini-3.1-flash-image-preview — Nano Banana 2 (Fast, 4K, $67/1k images) ⚡\n- gemini-3-pro-image-preview — Nano Banana Pro (Highest quality)\n- gemini-2.5-flash-image — Previous Flash model\n\nSee https://ai.google.dev/gemini-api/docs/image-generation for details."
        },
        "c4x.ai.visualGroundingContext": {
          "type": "string",
          "default": "",
          "maxLength": 300,
          "description": "Custom visual style context for PNG diagram generation (max 300 chars). This text is injected into the AI prompt to guide the visual style. Leave empty to use preset or default. Example: 'Dark theme with neon accents, transparent background, cyberpunk aesthetic'"
        },
        "c4x.ai.visualPreset": {
          "type": "string",
          "enum": [
            "default",
            "dark",
            "light",
            "pastel",
            "corporate"
          ],
          "default": "default",
          "description": "Visual style preset for PNG diagrams.\n\n• default — Clean white background, standard C4 colors\n• dark — Dark background, white/cyan text, neon accents\n• light — Bright white, high contrast, professional\n• pastel — Soft pastel palette, rounded corners, gentle aesthetic\n• corporate — Professional grey-blue palette, sharp edges, business-ready\n\nNote: Custom 'visualGroundingContext' overrides this preset."
        },
        "c4x.ai.layoutPreference": {
          "type": "string",
          "enum": [
            "balanced",
            "compact",
            "spacious"
          ],
          "default": "balanced",
          "description": "Layout spacing preference for PNG diagrams.\n\n• balanced — Standard spacing (default)\n• compact — Tighter spacing, more elements on screen\n• spacious — Generous padding, larger arrows, better readability"
        },
        "c4x.layout.persistence": {
          "type": "string",
          "enum": [
            "native",
            "sidecar"
          ],
          "default": "native",
          "description": "Specify where visual layout adjustments are saved.\n\n• native — Writes coordinates directly into native C4X files using $x, $y and $locked comments. Automatically falls back to sidecar for Structurizr or PlantUML formats (default).\n• sidecar — Writes all visual layout coordinates to a central .c4x-layout.json file in the workspace root or document directory."
        },
        "c4x.layout.spacing": {
          "type": "string",
          "enum": [
            "compact",
            "balanced",
            "spacious"
          ],
          "default": "balanced",
          "description": "Spacing between elements in automatic diagram layout.\n\n• compact — Tighter spacing (40/60px), more elements on screen\n• balanced — Standard spacing (60/80px, default)\n• spacious — Generous spacing (90/120px), better readability\n\nGroups with three or fewer children are automatically tightened by 25% to reduce empty space in small diagrams."
        },
        "c4x.edgesOnTop": {
          "type": "boolean",
          "default": true,
          "description": "Render relationship arrows above diagram nodes so connectors stay visible over large containers and deployment nodes (default). Set to false to paint edges behind nodes (legacy behaviour)."
        },
        "c4x.legend.show": {
          "type": "boolean",
          "default": true,
          "description": "Show the diagram legend overlay in the preview (default). The legend floats over the canvas — drag it or use arrow keys to reposition — and lists only the element types present in the current diagram. Set to false to hide it entirely."
        },
        "c4x.canvas.autoFitOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Automatically zoom the preview to fit the whole diagram when it is first opened (default). Set to false to open at 1:1, centred on the diagram. Save-triggered refreshes never re-fit the canvas."
        },
        "c4x.markdown.previewScale": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.2,
          "maximum": 1.0,
          "description": "Scale factor for C4X diagrams embedded in Markdown preview. 0.5 renders diagrams at half their intrinsic size. Changes apply on the next Markdown preview refresh."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "build": "node esbuild.config.js",
    "build:mcp": "node esbuild.config.js --mcp-only",
    "watch": "node esbuild.config.js --watch",
    "validate:toolchain": "node scripts/validate-toolchain-pins.js",
    "validate:harness": "node scripts/validate-agent-harness.js",
    "lint": "eslint src mcp",
    "lint:md": "markdownlint *.md **/*.md --ignore node_modules --ignore out",
    "generate:parser": "peggy --format commonjs --output src/parser/c4x.generated.js src/parser/c4x.pegjs",
    "validate:docs": "npm run lint:md && npx ts-node scripts/validate-c4x-examples.ts",
    "test:compile": "tsc -p ./",
    "pretest": "pnpm run test:compile && pnpm run build",
    "test": "node ./out/test/runTest.js",
    "test:unit": "mocha --config .mocharc.unit.yml",
    "test:snapshot": "mocha --config .mocharc.unit.yml --grep 'Diagram Snapshot|Diagram Geometric'",
    "test:snapshot:update": "node scripts/update-snapshots.js",
    "pretest:integration": "pnpm run test:compile && pnpm run build",
    "test:integration": "node ./out/test/runTest.js test/suite/extension-loading.test.js",
    "test:mcp": "node test/functional-mcp-server.js",
    "pretest:vsix-smoke": "pnpm run test:compile && pnpm run build && pnpm run package",
    "test:vsix-smoke": "node scripts/test-vsix-smoke.js",
    "//coverage": "Tier A (unit). Exclusion rationale + Tier B ownership in docs/adrs/TDR-017-coverage-tiering-and-exemptions.md. WritebackTransaction.ts + SidecarPersistence.ts moved to Tier A in Wave A/A1 (#50) via vscode-boundary seam.",
    "coverage": "c8 --all --exclude=src/parser/c4x.generated.js --exclude=src/parser/c4x.generated.d.ts --exclude=src/parser/c4x.js --exclude=\"src/commands/**\" --exclude=\"src/webview/**\" --exclude=\"src/export/**\" --exclude=\"src/diagnostics/**\" --exclude=\"src/extension.ts\" --exclude=\"src/ai/AuthService.ts\" --exclude=\"src/ai/CodeContextExtractor.ts\" --exclude=\"src/ai/GeminiService.ts\" --exclude=\"src/completion/**\" --exclude=\"src/markdown/**\" --exclude=\"src/parser/plantuml/index.ts\" --exclude=\"src/parser/plantuml/macros.ts\" --exclude=\"src/themes/Theme.ts\" --exclude=\"src/model/C4Model.ts\" --check-coverage --lines 80 --statements 80 --functions 80 --branches 85 --reporter=text --reporter=lcov --src=src mocha --config .mocharc.unit.yml",
    "//coverage:integration": "Tier B (extension-host). Evidence report, not a c8 gate. See TDR-017.",
    "coverage:integration": "c8 --all --reporter=text --reporter=lcov --report-dir=.coverage/integration --src=src pnpm test",
    "bench": "node -r ts-node/register test/benchmarks/performance.bench.ts",
    "verify:mcp": "node esbuild.config.js --check-mcp",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test test/playwright"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@playwright/test": "^1.57.0",
    "@types/dagre": "^0.7.53",
    "@types/glob": "^9.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.0",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.22.0",
    "c8": "^11.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^9.39.4",
    "eslint-plugin-security": "^3.0.1",
    "glob": "^11.0.3",
    "markdownlint-cli": "^0.46.0",
    "mocha": "^11.7.6",
    "peggy": "^5.1.0",
    "playwright": "^1.56.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.1"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "1.19.14",
      "express-rate-limit": "8.5.2",
      "fast-uri": "3.1.2",
      "hono": "4.12.29",
      "ip-address": "10.1.1",
      "path-to-regexp": "8.4.2",
      "qs": "6.15.3",
      "yargs": "17.7.3"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dagre": "^0.8.5",
    "markdown-it": "^14.1.0"
  }
}
